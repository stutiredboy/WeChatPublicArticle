# ==========================================================================
# km Agent - LLM 配置
# --------------------------------------------------------------------------
# 复制本文件为 .env，填入你的 API 信息。
# 支持任何 OpenAI 兼容接口（OpenAI / DeepSeek / 智谱 / 通义 / Moonshot /
# 豆包 volcengine / 自建 vLLM 等），改 base_url + model 即可。
# ==========================================================================

# --- 豆包 / volcengine 示例 ---
# KM_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# KM_LLM_MODEL=doubao-pro-32k
# KM_LLM_API_KEY=your-volcengine-api-key

# --- DeepSeek 示例 ---
# KM_LLM_BASE_URL=https://api.deepseek.com/v1
# KM_LLM_MODEL=deepseek-chat
# KM_LLM_API_KEY=your-deepseek-key

# --- OpenAI 示例 ---
KM_LLM_BASE_URL=https://api.openai.com/v1
KM_LLM_MODEL=gpt-4o-mini
KM_LLM_API_KEY=sk-your-key-here
